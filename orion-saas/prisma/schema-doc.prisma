  rankings        Ranking[]
  campaigns       Campaign[]

  @@unique([companyId, code], map: "udx_branches_company_code")
  @@index([companyId], map: "idx_branches_company")
  @@index([managerId], map: "idx_branches_manager")
  @@map("branches")
}

