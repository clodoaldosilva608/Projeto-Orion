  desktop
  @@map("application_type_saas")
}

enum ApplicationStatus {
  draft
  published
  deprecated
  archived
  @@map("application_status_saas")
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
  charged_back
  @@map("payment_status_saas")
}

enum AlertSeverity {
  info
  warning
  critical
  @@map("alert_severity_saas")
}

enum ActivityType {
  project_created
  payment_approved
  application_published
  license_renewed
  deploy_performed
  user_invited
