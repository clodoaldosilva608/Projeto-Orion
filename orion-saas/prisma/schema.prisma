  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId], map: "idx_point_tx_company_user")
  @@index([userId, createdAt], map: "idx_point_tx_user_date")
  @@index([reasonKey], map: "idx_point_tx_reason")
  @@map("point_transactions")
}

model PointRedemption {
  id          BigInt           @id @default(autoincrement())
  uuid        String           @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   BigInt           @map("company_id")
  userId      BigInt           @map("user_id")
  rewardKey   String           @map("reward_key") @db.VarChar(100)
  rewardName  String           @map("reward_name") @db.VarChar(255)
  pointsCost  Int              @map("points_cost")
  status      RedemptionStatus @default(pending)
  notes       String?          @db.Text
  reviewedBy  BigInt?          @map("reviewed_by")
  reviewedAt  DateTime?        @map("reviewed_at") @db.Timestamptz
  fulfilledAt DateTime?        @map("fulfilled_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  metadata    Json             @default("{}")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status], map: "idx_redemptions_company_status")
  @@index([userId], map: "idx_redemptions_user")
  @@map("point_redemptions")
}

// ================================================================
// P9 — CALENDÁRIO COMERCIAL
// ================================================================

enum CalendarEventType {
  holiday
  commemorative
  campaign_deadline
  company_event
  meeting
  training
  other

  @@map("calendar_event_type")
}

enum CalendarEventScope {
  company
  branch
  team
  personal

  @@map("calendar_event_scope")
}

model CalendarEvent {
  id          BigInt             @id @default(autoincrement())
  uuid        String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   BigInt             @map("company_id")
  branchId    BigInt?            @map("branch_id")
  userId      BigInt?            @map("user_id")
  title       String             @db.VarChar(255)
  description String?            @db.Text
  type        CalendarEventType  @default(other)
  scope       CalendarEventScope @default(company)
  startDate   DateTime           @map("start_date") @db.Timestamptz
  endDate     DateTime?          @map("end_date") @db.Timestamptz
  allDay      Boolean            @default(true) @map("all_day")
  location    String?            @db.VarChar(255)
  color       String             @default("#8b5cf6")
  isOfficial  Boolean            @default(false) @map("is_official")
  isRecurring Boolean            @default(false) @map("is_recurring")
  recurrence  String?            @db.VarChar(50)
  metadata    Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz
  createdBy   BigInt?            @map("created_by")
  updatedBy   BigInt?            @map("updated_by")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, startDate], map: "idx_calendar_company_start")
  @@index([companyId, type], map: "idx_calendar_company_type")
  @@index([companyId, scope], map: "idx_calendar_company_scope")
  @@index([userId], map: "idx_calendar_user")
  @@map("calendar_events")
}

// ================================================================
// P10 — MARKETPLACE DE PLUGINS v1
// ================================================================

enum PluginCategory {
  integration
  communication
  crm
  inventory
  commissions
  analytics
  automation
  other

  @@map("plugin_category")
}

model Plugin {
  id              BigInt          @id @default(autoincrement())
  uuid            String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String          @unique @db.VarChar(100)
  name            String          @db.VarChar(255)
  displayName     String          @map("display_name") @db.VarChar(255)
  description     String          @db.Text
  category        PluginCategory  @default(other)
  version         String          @db.VarChar(50) @default("1.0.0")
  author          String          @db.VarChar(255) @default("Orion Official")
  isOfficial      Boolean         @default(false) @map("is_official")
  iconUrl         String?         @map("icon_url")
  iconColor       String          @default("#8b5cf6") @map("icon_color")
  iconEmoji       String          @default("📦") @map("icon_emoji")
  homepageUrl     String?         @map("homepage_url") @db.Text
  docsUrl         String?         @map("docs_url") @db.Text
  configSchema    Json            @default("{}") @map("config_schema")
  defaultConfig   Json            @default("{}") @map("default_config")
  eventsSupported String[]        @default([]) @map("events_supported")
  installCount    Int             @default(0) @map("install_count")
  rating          Decimal?        @db.Decimal(2, 1)
  ratingCount     Int             @default(0) @map("rating_count")
  isFree          Boolean         @default(true) @map("is_free")
  priceCents      Int             @default(0) @map("price_cents")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category], map: "idx_plugins_category")
  @@index([isOfficial], map: "idx_plugins_official")
  @@index([isActive], map: "idx_plugins_active")
  @@map("plugins")
}

// ================================================================
// P12 — CHECKLIST DIÁRIO
// ================================================================

enum ChecklistTemplateScope {
  personal
  role
  team
  company

  @@map("checklist_template_scope")
}

enum ChecklistTaskStatus {
  pending
  done
  skipped
  overdue

  @@map("checklist_task_status")
}

// Template: define which tasks should appear each day
model ChecklistTemplate {
  id          BigInt                  @id @default(autoincrement())
  uuid        String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   BigInt                  @map("company_id")
  name        String                  @db.VarChar(255)
  description String?                 @db.Text
  scope       ChecklistTemplateScope  @default(personal)
  roleId      BigInt?                 @map("role_id")
  branchId    BigInt?                 @map("branch_id")
  isActive    Boolean                 @default(true) @map("is_active")
  startsAt    String                  @default("09:00") @map("starts_at") @db.VarChar(5)
  endsAt      String                  @default("18:00") @map("ends_at") @db.VarChar(5)
  weekdays    String                  @default("1,2,3,4,5") @db.VarChar(20) // ISO: 1=Mon ... 7=Sun
  metadata    Json                    @default("{}")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?               @map("deleted_at") @db.Timestamptz
  createdBy   BigInt?                 @map("created_by")

  company Company           @relation(fields: [companyId], references: [id])
  items   ChecklistItem[]
  tasks   ChecklistTask[]

  @@index([companyId, isActive], map: "idx_checklist_templates_active")
  @@index([companyId, scope], map: "idx_checklist_templates_scope")
  @@map("checklist_templates")
}

// Item: a task definition that belongs to a template
model ChecklistItem {
  id           BigInt   @id @default(autoincrement())
  templateId   BigInt   @map("template_id")
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  points       Int      @default(10) // points awarded when completed
  isRequired   Boolean  @default(true) @map("is_required")
  estimatedMin Int?     @map("estimated_min") // estimated duration in minutes
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    ChecklistTask[]

  @@index([templateId], map: "idx_checklist_items_template")
  @@index([sortOrder], map: "idx_checklist_items_sort")
  @@map("checklist_items")
}

// Task: an instance of an item for a specific user on a specific date
model ChecklistTask {
  id          BigInt             @id @default(autoincrement())
  uuid        String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   BigInt             @map("company_id")
  templateId  BigInt             @map("template_id")
  itemId      BigInt             @map("item_id")
  userId      BigInt             @map("user_id")
  date        DateTime           @db.Date // the day this task belongs to
  status      ChecklistTaskStatus @default(pending)
  completedAt DateTime?          @map("completed_at") @db.Timestamptz
  notes       String?            @db.Text
  metadata    Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  company  Company           @relation(fields: [companyId], references: [id])
  template ChecklistTemplate @relation(fields: [templateId], references: [id])
  item     ChecklistItem     @relation(fields: [itemId], references: [id])
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, date], map: "udx_checklist_tasks_user_item_date")
  @@index([companyId, date], map: "idx_checklist_tasks_company_date")
  @@index([userId, date], map: "idx_checklist_tasks_user_date")
  @@index([userId, status], map: "idx_checklist_tasks_user_status")
  @@map("checklist_tasks")
}
