# ==============================================
# ORION - Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha os valores
# ==============================================

# Banco de Dados (Prisma + Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"
SUPABASE_SECRET_KEY="sua-secret-key-aqui"
SUPABASE_JWKS_URL="https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orion"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# JWT / Auth
JWT_SECRET="seu-segredo-jwt-minimo-32-caracteres"
JWT_EXPIRES_IN="7d"

# Ambiente
NODE_ENV="development"
